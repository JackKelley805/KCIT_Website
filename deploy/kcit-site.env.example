# Copy custom values to /etc/kcit-site.env after installation, then run:
#   sudo systemctl restart kcit-site
HOST=127.0.0.1
PORT=3000
DATA_DIR=/var/lib/kcit-site
BODY_LIMIT_BYTES=16384
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_SUBMISSIONS=5
ALLOWED_ORIGINS=https://kelleycomputers-it.com,https://www.kelleycomputers-it.com
# Add the private IP of the Nginx reverse-proxy VM.
TRUSTED_PROXY_IPS=127.0.0.1

# Mailgun contact-form notifications. Never commit a real API key.
MAILGUN_API_KEY=key-REPLACE_WITH_YOUR_PRIVATE_API_KEY
MAILGUN_DOMAIN=mg.example.com
MAILGUN_TO=support@example.com
MAILGUN_FROM="Kelley Computers Website <website@mg.example.com>"
# Use https://api.eu.mailgun.net if your Mailgun domain is in the EU region.
MAILGUN_API_BASE=https://api.mailgun.net
MAILGUN_TIMEOUT_MS=10000
